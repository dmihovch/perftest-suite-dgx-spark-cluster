# Dual-cable RDMA campaign environment.
# Source before running any script:
#   source rdma-dual-cable.env
#
# scripts/load_env.sh gives already-exported values precedence over .env,
# so sourcing this file once per shell session is enough.

export CX_IFACE="enp1s0f0np0,enP2p1s0f0np0,enp1s0f1np1,enP2p1s0f1np1"
export NCCL_IB_DISABLE=0

# Uncomment if the internal NVMe has less than ~600 GB free.
# export HF_CACHE=/mnt/model-cache